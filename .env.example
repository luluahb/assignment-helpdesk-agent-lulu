# Salin file ini menjadi .env lalu isi dengan API key milikmu sendiri.
# File .env TIDAK boleh di-commit (sudah tercantum di .gitignore).

# Wajib: API key Gemini (buat di https://aistudio.google.com/apikey)
GEMINI_API_KEY=your_api_key_here

# Opsional: model yang digunakan (default di bawah dipakai jika tidak diisi)
EMBEDDING_MODEL=gemini-embedding-001
LLM_MODEL=gemini-3.5-flash-lite

# Opsional: skor cosine minimum agar FAQ dianggap relevan (0-1)
RELEVANCE_THRESHOLD=0.65
